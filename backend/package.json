{
  "name": "desafio-plus-backend",
  "version": "1.0.0",
  "description": "Desafio+ API — Backend Node.js/Express para Cloudflare Workers",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute desafio-plus-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute desafio-plus-db --local --file=./schema.sql"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "google-auth-library": "^9.11.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.9.14",
    "openai": "^4.52.7",
    "uuid": "^10.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "wrangler": "^3.63.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
