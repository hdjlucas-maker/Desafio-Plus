# ─────────────────────────────────────────────────────────────────────────────
# Desafio+ — .env (Desenvolvimento Local)
# ─────────────────────────────────────────────────────────────────────────────
# ATENÇÃO: Nunca suba este arquivo para o GitHub (.gitignore já o exclui)
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# ── JWT (autenticação) ────────────────────────────────────────────────────────
# Secret FIXO — não muda entre reinicializações, tokens continuam válidos
JWT_SECRET=desafioplus_secret_key_2026_local_dev_segura_nao_usar_em_producao
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Banco de dados ────────────────────────────────────────────────────────────
DB_PATH=./desafio-plus.db

# ── Upload de arquivos ────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads/

# ── Google OAuth (opcional — deixe em branco se não usar) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8787/api/auth/google/callback

# ── OpenAI (opcional — o app funciona sem isso) ───────────────────────────────
OPENAI_API_KEY=
