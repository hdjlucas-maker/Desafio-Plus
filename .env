# ── Servidor ──────────────────────────────────────────────
NODE_ENV=development
PORT=8787

# ── JWT ───────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=seu_jwt_secret_super_seguro_aqui_minimo_64_chars
JWT_REFRESH_SECRET=seu_refresh_secret_diferente_do_access_token

# ── Google OAuth ──────────────────────────────────────────
# Crie em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=967168058446-u2iuce49oacigcuci4rshb7613sm1jf9.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# ── OpenAI ────────────────────────────────────────────────
# Crie em: https://platform.openai.com/api-keys
OPENAI_API_KEY=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

# ── Cloudflare R2 (Storage) ───────────────────────────────
# Crie em: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=seu_r2_access_key_id
R2_SECRET_ACCESS_KEY=seu_r2_secret_access_key
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=desafio-plus-media
R2_PUBLIC_URL=https://media.desafio-plus.com

# ── E-mail (recuperação de senha) ─────────────────────────
# Use Gmail, SendGrid, Resend, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua_senha_de_app_gmail
SMTP_FROM=noreply@desafio-plus.com

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://desafio-plus.pages.dev

# ── Frontend (React) ──────────────────────────────────────
REACT_APP_API_URL=http://localhost:8787/api
REACT_APP_GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com

# ── Banco de dados (desenvolvimento local) ────────────────
DB_PATH=./desafio-plus.db
